{
  "name": "@app/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"evals/**/*.ts\" --max-warnings 0",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "eval": "tsx evals/run-evals.ts"
  },
  "dependencies": {
    "@app/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "mammoth": "^1.13.0",
    "openai": "^7.47.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@app/eslint-config": "*",
    "@app/tsconfig": "*",
    "@types/node": "^22.10.0"
  }
}
