# Optional: copy to .env at the repo root to change these. .env is git-ignored.
# The API (apps/api) and the CLI (apps/cli) both read this one file.

# There is no database. Everything else is set in the app under Settings and saved in
# ~/.nimbrio-ai/ (workspaces, models, agent and MCP settings; chats and memory live in
# each workspace's own folder):
#   Models: the models to chat with (as many as you like, picked per message)
#   Agent:  tool approvals, planning, step / token / prompt limits, SearXNG URL, log level

# ---- Evals only (npm run eval) ----
# Evals don't read the app's saved models, so they name their model here. Any OpenAI-compatible
# server; leave EVAL_BASE_URL empty for api.openai.com.
EVAL_BASE_URL=
EVAL_API_KEY=
EVAL_MODEL=
# low | medium | high, only for reasoning models that support it
EVAL_REASONING_EFFORT=

# ---- Run logs ----
# Folder for the JSONL run logs (default ~/.nimbrio-ai/logs). The console level is in the app.
AGENT_LOG_DIR=

# ---- API server (apps/api) ----
# Listens on 127.0.0.1 only. The web dev server (port 5173) proxies /v1 here.
PORT=4000
# Origins allowed to call the API from a browser (comma-separated)
CORS_ORIGIN=http://localhost:5173
# ---- Sign-in (optional) ----
# Set both to make everyone sign in with Supabase Auth (email and password) before using the app.
# Leave both empty to run without sign-in, as before. From the Supabase dashboard: Project
# Settings → API (the project URL and the anon / publishable key; never the service_role key).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Who may use the app once signed in (comma-separated emails). Empty lets in every user of the
# Supabase project, so set this, or turn off new sign-ups in Supabase: the agent can run commands.
AUTH_ALLOWED_EMAILS=

# HTTP request logs: fatal | error | warn | info | debug | trace | silent
# One compact line per request, never headers or cookies. Background polling (tasks, info) logs
# at debug, so set LOG_LEVEL=debug to see it.
LOG_LEVEL=info
