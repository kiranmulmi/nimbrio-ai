{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@app/agent": "*",
    "@app/db": "*",
    "@app/shared": "*",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "node-pty": "^1.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@app/eslint-config": "*",
    "@app/tsconfig": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2"
  }
}
